{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Zabbix Exporter API requests, scheduler pressure, cache health, and Remote Write publishing.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Age of the last complete metadata snapshot. Compare this with collector.metadata_refresh_interval; sustained growth means metadata refresh is failing. If the first refresh never succeeds, inspect API Error Ratio and Metadata Refresh Results.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1200 }, { "color": "red", "value": 2400 }] }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "10.0.0",
      "targets": [{ "editorMode": "code", "expr": "max(zabbix_exporter_metadata_age_seconds{job=~\"$job\",instance=~\"$instance\"})", "legendFormat": "metadata age", "range": true, "refId": "A" }],
      "title": "Metadata Snapshot Age",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Share of Zabbix API requests whose status is not success.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 2, "max": 1, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "10.0.0",
      "targets": [{ "editorMode": "code", "expr": "(sum(rate(zabbix_exporter_api_requests_total{job=~\"$job\",instance=~\"$instance\",status!=\"success\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(zabbix_exporter_api_requests_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])), 1e-9)", "legendFormat": "error ratio", "range": true, "refId": "A" }],
      "title": "Zabbix API Error Ratio",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Fresh ValueCache entries divided by enabled numeric metadata items. A low ratio shows that collection problems are affecting exported data.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 1, "max": 1, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.9 }, { "color": "green", "value": 0.95 }] }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "10.0.0",
      "targets": [{ "editorMode": "code", "expr": "sum(zabbix_exporter_value_cache_fresh_entries{job=~\"$job\",instance=~\"$instance\"}) / clamp_min(sum(zabbix_exporter_metadata_enabled_items{job=~\"$job\",instance=~\"$instance\"}), 1)", "legendFormat": "fresh coverage", "range": true, "refId": "A" }],
      "title": "Fresh Cache Coverage",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Current scheduled group queue depth. A value pinned at capacity indicates collection backpressure.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 64 }, { "color": "red", "value": 128 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "10.0.0",
      "targets": [{ "editorMode": "code", "expr": "sum(zabbix_exporter_scheduler_queue_entries{job=~\"$job\",instance=~\"$instance\"})", "legendFormat": "scheduler queue", "range": true, "refId": "A" }],
      "title": "Collection Scheduler Queue",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Current Remote Write batches waiting for a worker.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 50 }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "10.0.0",
      "targets": [{ "editorMode": "code", "expr": "sum(zabbix_exporter_push_queue_entries{job=~\"$job\",instance=~\"$instance\"})", "legendFormat": "push queue", "range": true, "refId": "A" }],
      "title": "Remote Write Queue",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Share of Remote Write outcomes that are queue-full, retryable, or permanent failures. Retryable failures usually indicate network, HTTP 429, or HTTP 5xx; permanent failures usually indicate URL, authentication, tenancy, or protocol problems.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 2, "max": 1, "min": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] }, "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto", "wideLayout": true },
      "pluginVersion": "10.0.0",
      "targets": [{ "editorMode": "code", "expr": "(sum(rate(zabbix_exporter_push_batches_total{job=~\"$job\",instance=~\"$instance\",status=~\"queue_full|retryable_failure|permanent_failure\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(zabbix_exporter_push_batches_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])), 1e-9)", "legendFormat": "failure ratio", "range": true, "refId": "A" }],
      "title": "Remote Write Failure Ratio",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "id": 100,
      "panels": [],
      "title": "Zabbix API Requests",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Breaks errors down by method and status. transport_error/timeout usually indicates connectivity or TLS; http_error indicates an HTTP endpoint or proxy issue; api_error commonly indicates authentication, permissions, or invalid requests; decode_error indicates an unexpected response.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 12, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 10,
      "options": { "legend": { "calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (method, status) (rate(zabbix_exporter_api_requests_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{method}} / {{status}}", "range": true, "refId": "A" }],
      "title": "API Request Rate by Method and Status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 11,
      "options": { "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "(sum by (method) (increase(zabbix_exporter_api_request_duration_seconds_sum{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])) / sum by (method) (increase(zabbix_exporter_api_request_duration_seconds_count{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))) and on (method) (sum by (method) (increase(zabbix_exporter_api_request_duration_seconds_count{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])) > 0)", "legendFormat": "avg {{method}}", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (method, le) (rate(zabbix_exporter_api_request_duration_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "p95 {{method}}", "range": true, "refId": "B" }
      ],
      "title": "API Average and P95 Request Duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "A failed metadata refresh preserves the last complete snapshot. Repeated error or canceled results together with a rising snapshot age identify the metadata path as the fault domain.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 15, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "normal" }, "thresholdsStyle": { "mode": "off" } }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 },
      "id": 12,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (status) (rate(zabbix_exporter_metadata_refresh_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{status}}", "range": true, "refId": "A" }],
      "title": "Metadata Refresh Results",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "History batch outcomes and the 5-minute rate of responses that reached the configured limit. api_error/timeout/decode_error means collection from Zabbix is failing; limit hits mean data may be truncated.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 13 },
      "id": 13,
      "options": { "legend": { "calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum by (status) (rate(zabbix_exporter_history_batches_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{status}}", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(zabbix_exporter_history_limit_hits_total{job=~\"$job\",instance=~\"$instance\"}[5m]))", "legendFormat": "limit hits / s", "range": true, "refId": "B" }
      ],
      "title": "History Batch Results and Limit-hit Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 12, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } }, "unit": "short" }, "overrides": [{ "matcher": { "id": "byFrameRefID", "options": "D" }, "properties": [{ "id": "unit", "value": "s" }] }] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 13 },
      "id": 14,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(zabbix_exporter_scheduler_queue_entries{job=~\"$job\",instance=~\"$instance\"})", "legendFormat": "queue", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(zabbix_exporter_scheduler_inflight{job=~\"$job\",instance=~\"$instance\"})", "legendFormat": "inflight", "range": true, "refId": "B" },
        { "editorMode": "code", "expr": "sum(rate(zabbix_exporter_group_runs_total{job=~\"$job\",instance=~\"$instance\",status=\"queue_full\"}[$__rate_interval]))", "legendFormat": "queue_full/s", "range": true, "refId": "C" },
        { "editorMode": "code", "expr": "histogram_quantile(0.95, sum by (le) (rate(zabbix_exporter_scheduler_lag_seconds_bucket{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval])))", "legendFormat": "lag p95", "range": true, "refId": "D" }
      ],
      "title": "Scheduler Pressure",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Counters since the selected exporter process started or since the counter was reset.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "id": 15,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true },
      "targets": [{ "editorMode": "code", "expr": "sum by (method, status) (zabbix_exporter_api_requests_total{job=~\"$job\",instance=~\"$instance\"})", "format": "table", "instant": true, "legendFormat": "{{method}} / {{status}}", "range": false, "refId": "A" }],
      "title": "Cumulative API Request Count",
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Cumulative average latency since process start. Use the time-series panel above for a recent moving average.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 3, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "id": 16,
      "options": { "cellHeight": "sm", "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false }, "showHeader": true },
      "targets": [{ "editorMode": "code", "expr": "sum by (method) (zabbix_exporter_api_request_duration_seconds_sum{job=~\"$job\",instance=~\"$instance\"}) / clamp_min(sum by (method) (zabbix_exporter_api_request_duration_seconds_count{job=~\"$job\",instance=~\"$instance\"}), 1)", "format": "table", "instant": true, "legendFormat": "{{method}}", "range": false, "refId": "A" }],
      "title": "Cumulative Average API Request Duration",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 101,
      "panels": [],
      "title": "Remote Write Publishing",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "description": "Remote Write outcomes by status. retryable_failure points to network, throttling, or server errors; permanent_failure points to URL, authentication, tenant, or protocol configuration; queue_full indicates publisher backpressure.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 12, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } }, "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "id": 20,
      "options": { "legend": { "calcs": ["lastNotNull", "mean"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (status) (rate(zabbix_exporter_push_batches_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{status}}", "range": true, "refId": "A" }],
      "title": "Remote Write Batch Result Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } }, "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "id": 21,
      "options": { "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "editorMode": "code", "expr": "sum by (encoding) (rate(zabbix_exporter_push_batch_bytes_sum{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "{{encoding}}", "range": true, "refId": "A" }],
      "title": "Remote Write Throughput",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 12, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } }, "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 35 },
      "id": 22,
      "options": { "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "editorMode": "code", "expr": "sum(zabbix_exporter_push_queue_entries{job=~\"$job\",instance=~\"$instance\"})", "legendFormat": "queue", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "sum(rate(zabbix_exporter_push_coalesced_cycles_total{job=~\"$job\",instance=~\"$instance\"}[$__rate_interval]))", "legendFormat": "coalesced/s", "range": true, "refId": "B" }
      ],
      "title": "Push Queue and Coalesced Cycles",
      "type": "timeseries"
    },
    {
